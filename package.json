{
  "name": "obsidian-vault-bridge",
  "version": "1.0.7",
  "description": "Open a token-protected port on your computer, then upload and download vault files from your phone over a URL.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "node tools/verify-bundle.mjs",
    "bench": "node tools/bench.mjs",
    "tunnel": "bash tools/tunnel.sh",
    "install:plugin": "node tools/install.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vault",
    "file-transfer",
    "upload",
    "download",
    "lan",
    "self-hosted"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.7.2",
    "prettier": "^3.9.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
